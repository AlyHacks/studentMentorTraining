# SQLite database file (relative to prisma/ or an absolute path)
DATABASE_URL="file:./dev.db"

# NextAuth
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Comma-separated emails that are auto-promoted to ADMIN on registration.
# The very first person to register is also made an admin automatically.
ADMIN_EMAILS="you@example.com"

# Optional: SMTP settings to email certificates automatically when a
# student hits 100%. If unset, certificates are still generated and can be
# downloaded from the dashboard — they just won't be emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
